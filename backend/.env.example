NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,https://prosistable.netlify.app/

# PostgreSQL connection string (Neon serverless Postgres)
# Get this from your Neon project dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Base URL of the frontend app (used to build links embedded in emails,
# e.g. password reset links)
APP_URL=http://localhost:5173

# Resend (https://resend.com) — used to send transactional emails such as
# password reset links. Get an API key from https://resend.com/api-keys.
# If left blank in development, emails are logged to the console instead
# of sent, so the app still works without a real account.
RESEND_API_KEY=

# Must be a verified sender on your Resend domain/account in production.
# The default below (onboarding@resend.dev) only works for testing and
# only delivers to the email address you signed up to Resend with.
EMAIL_FROM="Prosisit Table <onboarding@resend.dev>"

