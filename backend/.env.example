# Base URL of the frontend app, used to build links embedded in emails and SMS
# (password reset, reservation confirmation).
# IMPORTANT: in production this must be your public site URL, e.g.
#   APP_URL=https://your-site.com
# Leaving it as localhost sends customers confirmation links they cannot open.
# The server refuses to boot with a localhost value when NODE_ENV=production.
APP_URL=http://localhost:5173

# Resend (https://resend.com) — used to send transactional emails such as
# password reset links. Get a free API key from https://resend.com/api-keys.
# Leave blank to fall back to console logging instead of real sending.
RESEND_API_KEY=re_4QbdHZxr_BFufQYG67Q7ph8symzBXMrYf

# Must be a verified sender on your Resend domain/account in production.
EMAIL_FROM="Seat Booking <booking@seatbooking.dk>"

TWILIO_ACCOUNT_SID=AC7cfa61a91b501b1c4bfcef376f326800
TWILIO_AUTH_TOKEN=389264fa776531d26b9abfead2cd4e6a

# Your Twilio sending number in E.164 format (e.g. +15005550006), or a
# Messaging Service SID. On a trial account you can only deliver to numbers
# you've verified at twilio.com/console/phone-numbers/verified.
TWILIO_PHONE_NUMBER=71867223

# Country calling code applied to customer phone numbers stored without an
# international prefix (e.g. "12345678" -> "+4512345678"). Leave blank to
# reject such numbers rather than risk texting the wrong country.
SMS_DEFAULT_COUNTRY_CODE=+45

